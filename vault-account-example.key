# HashiCorp Vault connection credentials for KCS pre-installation check
# Used by: kcs_k8s_check.sh --vault <HOST> --vault-account <this-file>
#
# Generate with: bash generate-vault-account.sh <vault-addr> <token>
# or create manually with the fields below.

# Full Vault server URL — must be reachable from within the Kubernetes pod network
VAULT_ADDR=http://10.160.6.210:8200

# Vault token with read access to KCS secret paths.
# In production: create a limited token scoped to KCS KV paths with a short TTL.
#   vault token create -policy=kcs-readonly -ttl=1h
# For testing: root token (dev mode) or any valid token works.
VAULT_TOKEN=kcs-test-root-token
